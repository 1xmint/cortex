# Cortex — Environment Variables
# VPS: copy to /etc/cortex/cortex.env
# Local dev: copy to .env (gitignored)
#
# Rule: the presence of a key IS the configuration.
# No CLERK_SECRET_KEY = auth disabled (dev mode).
# No CORTEX_ALLOWED_ORIGINS = CORS permissive (dev mode).

# ─── Server ───
CORTEX_PORT=3001
RUST_LOG=info,cortex_api=info

# The verification dispatcher refuses to start without this, and the server
# exits rather than serving without one. Set it only where exactly one node
# runs: the SQLite store is a Mutex<Connection> that two processes do not
# share, so two dispatchers would grade every delivery twice. A Postgres
# dispatcher removes the constraint; until then the assertion is the guard.
CORTEX_SINGLE_NODE=1

# ─── Auth (Clerk) ───
# https://dashboard.clerk.com → API Keys
# When set: JWT verification enforced on protected endpoints.
# When absent: all requests treated as user "local" (dev mode).
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Worker credential ---
# Workers authenticate with a `cwk_` service key, not a Clerk user JWT: a
# headless daemon has no browser and can never obtain one. Mint keys on the
# host with `cortex-worker-key issue --owner <clerk_user_id>` and put the
# secret in the worker's env as CORTEX_TOKEN. There is no HTTP issuance route.
#
# CORTEX_ALLOW_ANONYMOUS_WORKER=1 lets a worker connect with NO credential at
# all, as the user `local`. Development only. Leave it unset in production.
#
# Note it is deliberately not tied to CLERK_SECRET_KEY. An absent Clerk secret
# used to be enough on its own to accept any worker; that is what this flag
# replaced, because a deployment can lose CLERK_SECRET_KEY by accident and
# nobody sets this variable by accident.
CORTEX_ALLOW_ANONYMOUS_WORKER=

# ─── CORS ───
# Comma-separated allowed origins. When absent: permissive (dev mode).
CORTEX_ALLOWED_ORIGINS=https://cortex.heyvera.org

# ─── Stripe (Billing) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_CREDIT_PACK=
STRIPE_SUCCESS_URL=https://cortex.heyvera.org/billing?success=true
STRIPE_CANCEL_URL=https://cortex.heyvera.org/billing?cancelled=true

# ─── Database ───
# MUST point outside the git checkout in production. Deploys run
# `git reset --hard`, which destroys any database stored under the repo.
# Default when unset: <CORTEX_WORKSPACE>/.cortex/cortex.db (dev only).
CORTEX_DB_PATH=/var/lib/cortex/cortex.db
CORTEX_LEDGER_PATH=/var/lib/cortex/ledger.jsonl
CORTEX_ROUTING_DB_PATH=/var/lib/cortex/routing.db

# ─── Worker ───
# Shared secret for worker WebSocket auth (optional for dev).
# CORTEX_WORKER_SECRET=

# ─── Admin Access ───
# Comma-separated list of admin email addresses
CORTEX_ADMIN_EMAILS=jfair1028@gmail.com

# ─── Operator-funded provider keys ───
# ⚠️ These are the OPERATOR's keys — yours — not the caller's. They are NOT
# "BYOS mode"; bring-your-own-subscription uses per-user credentials from the
# user_credentials table and never touches these.
#
# The only thing that reads them today is the fallback in stream_chat_cli:
# when a user's own CLI auth fails, the request is retried on YOUR key. That
# path runs no budget check, opens no cost session, and has no cost_type to be
# recorded under — so it is uncapped, unattributed, and invisible.
#
# Because of that it is now opt-in. Setting a key alone does nothing; you must
# also set CORTEX_PLATFORM_FALLBACK=1. Leave the flag off until platform spend
# is metered, otherwise every broken user login quietly bills you.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...

# Bill failed user CLI auth to the operator's keys above. Default: off.
# CORTEX_PLATFORM_FALLBACK=1

# CLI tool paths (optional - override if not in PATH)
# CORTEX_CLAUDE_PATH=/custom/path/to/claude
# CORTEX_CODEX_PATH=/custom/path/to/codex

# CLI timeout in seconds (default: 300)
# CORTEX_CLI_TIMEOUT_SECS=300

# ─── Provider Auth Management ───
# Enable admin UI for provider authentication
# CORTEX_PROVIDER_AUTH_ENABLED=true

# ─── Environment ───
# Set to "production" to enable strict security checks
CORTEX_ENV=development
