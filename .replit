modules = ["nodejs-20", "web", "bash", "rust"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"


# Claude persistence (added by DATA Tools)
onBoot = "source /home/runner/workspace/.replit-tools/scripts/setup-claude-code.sh 2>/dev/null || true"
packages = ["tmux"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd cortex && npm run dev"
waitForPort = 5001

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CORTEX_ADMIN_EMAILS='jfair1028@gmail.com' ./target/release/cortex-server"
waitForPort = 3001

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3009
externalPort = 4200

[[ports]]
localPort = 3499
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 9999
externalPort = 3003

[userenv]

[userenv.shared]
PORT = "3000"
NODE_ENV = "development"
LOG_LEVEL = "info"
LLM_PROVIDER = "anthropic"
ANTHROPIC_MODEL = "claude-sonnet-4-20250514"
OPENAI_MODEL = "gpt-4o"
OPENCLAW_API_URL = "http://localhost:3000"
CACHE_TTL_SECONDS = "300"
CACHE_MAX_MEMORY_ITEMS = "10000"
RATE_LIMIT_PER_MIN = "60"
DB_PATH = "./data/orchestrator.db"
WEBAUTHN_RP_ID = "localhost"
WEBAUTHN_RP_ORIGIN = "http://localhost:3000"
MARKUP_PERCENT = "15"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "dist/index.js"]
build = ["bash", "-c", "cd dashboard && npm install && npm run build && cd .. && npm run build"]
