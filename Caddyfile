# Cortex — Caddy reverse proxy config
# Cortex's part of the shared /etc/caddy/Caddyfile on the Cortex host.
# Merge it into that file by hand; copying it over the live file would drop
# HeyVera's routes and sites.
#
# API:  localhost:3001         (cortex-api, the only backend this file knows)
#
# This file used to carry six other sites — the Cortex SPA, the HeyVera SPA,
# the Socials API, Pulse, Radar and the ClawNet marketing site. They belong to
# the HeyVera repository, or (for the Cortex SPA) moved to Cloudflare Pages,
# and were removed when Cortex became its own repository. If a request for
# one of those arrives here it should 404, not be quietly proxied somewhere;
# that is the point of not having a broad fallback.
#
# cortex.heyvera.org is now a Cloudflare Pages static site and no longer
# reaches this host at all, so its Caddy block was deleted rather than kept
# around unserved. The provider gateway lives on api.heyvera.org, below,
# because a Pages site cannot proxy anything.
#
# api.heyvera.org is shared with the HeyVera repository. The live host also
# carries HeyVera's /v1/social/*, /v1/pulse/*, /v1/health, /v1/ready and
# /v1/* routes (to localhost:3002 and localhost:3402); those belong to the
# heyvera repo and are not listed here. Only Cortex's own two routes are
# below.
#
# A sandbox is handed a provider-gateway bearer that is only valid against
# this host (see cortex_core::egress::PROVIDER_GATEWAY_HOST). That bearer's
# reach past this hostname is bounded elsewhere, not by this file having no
# other routes on it: the worker's strict `https://{host}/` prefix check
# (crates/worker/src/sandbox/policy.rs), the sandbox egress allowlist, and
# /api/* requiring a Clerk JWT that the bearer does not carry.
#
# Because the host is shared, sandbox code can also reach HeyVera's public
# /v1/* routes here, with no credentials. Before real customer code runs, the
# gateway should get a hostname of its own that forwards only
# /internal/provider/*, so the sandbox reaches nothing else.
api.heyvera.org {
	# The provider gateway. Bare reverse_proxy: this is a machine-to-machine
	# route, not a browser request, so it carries none of the header_up
	# rewriting below.
	handle /internal/provider/* {
		reverse_proxy localhost:3001
	}

	# Cortex product API
	handle /api/* {
		reverse_proxy localhost:3001 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# /metrics is deliberately NOT forwarded here: Prometheus scrapes over
	# the private network, and publishing it on this public hostname would
	# be a change in exposure, not a fix.

	# No match above: not a Cortex route. (The live host also has HeyVera's
	# routes here; this repo does not own or list them.)
	handle {
		respond "Not found" 404
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
