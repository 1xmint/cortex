# https://editorconfig.org
# Kept minimal and consistent with what the repo already does. Anything not
# listed here is deliberately left to the language's own formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
# rustfmt owns Rust. These values mirror rustfmt.toml so an editor that has
# never run rustfmt still produces the same shape.
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[Dockerfile*]
indent_size = 2
