VITE_SENTRY_DSN=

# Analytics
VITE_PLAUSIBLE_DOMAIN=cortex.heyvera.org

# Soma UI. Leave unset.
#
# Soma is work-in-progress and is fenced out of the backend by a cargo feature
# that is off by default, so `/api/soma/*` 404s in every build we deploy. This
# flag hides the frontend that calls those endpoints.
#
# Setting it to 'true' does not make the spend tab work — it makes it render
# errors. It is only correct to set alongside a backend built with
# `--features soma`, which must not be a production deployment.
# See docs/adr/ADR-0003-soma-feature-fence.md.
# VITE_CORTEX_SOMA_ENABLED=

# Unbuilt backends. Leave all three unset.
#
# These differ from the Soma flag above: Soma is fenced out of a backend that
# exists, while these three have no routes behind them at all and never have
# in any commit. The UI for them is finished, so it is hidden rather than
# deleted and these are the switches to flip when the routes land. Setting one
# now only turns a hidden panel into a 404.
#
# `crates/api/route-manifest.csv` is the list of what the backend actually
# serves, and `cortex/src/lib/api-contract.test.ts` fails if the frontend
# calls anything that is not on it or named in its allowance list.

# Workspace memory: /api/memory/*
# VITE_CORTEX_MEMORY_ENABLED=

# Budgets and cost warnings: /api/budget/*
# Hides the "Budget & Costs" tab in Settings.
# VITE_CORTEX_BUDGET_ENABLED=

# Project file tree, workspace links, repo sync, name validation, templates
# and GitHub import: the six /api/projects/* paths the backend does not serve.
# VITE_CORTEX_PROJECT_WORKSPACE_ENABLED=
